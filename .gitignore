# Dependencies and build output
node_modules/
dist/
release/
out/
coverage/
*.tsbuildinfo
*.tgz
.eslintcache
.cache/
.npm/

# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.cer
*.mobileprovision
secrets.json
settings.local.json
config.local.json

# Logs and debug output
*.log
npm-debug.log*
logs/
smoke-output/
smoke-*/

# Locally supplied artwork that may not be redistributable (e.g. Clawd imported
# from your own Claude app). Put sprite packs in the app's user-data folder or here.
assets/sprites/local/
assets/sprites/*/
!assets/sprites/placeholder/

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

