# Dependencies and build output
node_modules/
dist/
release/
out/
coverage/
*.tsbuildinfo

# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
settings.local.json
config.local.json

# Logs and debug output
*.log
npm-debug.log*
logs/
smoke-output/

# Locally supplied artwork that may not be redistributable.
# Put authorized Clawd sprite packs here (or in the app's user-data folder).
assets/sprites/local/
assets/sprites/*/
!assets/sprites/placeholder/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
smoke-*/
